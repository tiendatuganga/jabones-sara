---
import { site } from "../config/site";
import Section from "./ui/Section.astro";

const { instructor } = site;
---

<Section tone="sand" id="instructor">
  <div class="mx-auto grid max-w-4xl items-center gap-8 md:grid-cols-[auto_1fr] md:gap-12">
    <div
      class="mx-auto flex h-36 w-36 items-center justify-center rounded-full bg-sage-700 font-display text-5xl font-bold text-cream-50 ring-8 ring-sage-100 sm:h-44 sm:w-44 sm:text-6xl"
      aria-hidden="true"
    >
      {instructor.initials}
    </div>
    <div class="text-center md:text-left">
      <p class="mb-2 text-sm font-semibold uppercase tracking-widest text-sage-700">{instructor.eyebrow}</p>
      <h2 class="font-display text-3xl font-bold text-sage-900 sm:text-4xl">{instructor.name}</h2>
      <p class="mt-1 font-medium text-ink-soft">{instructor.role}</p>
      <div class="mt-5 space-y-3 text-lg leading-relaxed text-ink-soft">
        {instructor.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</Section>
