---
import { site } from "../config/site";
---

<div class="bg-sage-700 text-cream-50">
  <ul class="mx-auto grid max-w-6xl gap-3 px-5 py-5 text-center text-sm font-semibold sm:grid-cols-3 sm:px-8">
    {
      site.trust.map((item) => (
        <li class="flex items-center justify-center gap-2">
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 text-honey-300" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.79 6.8-6.8a1 1 0 0 1 1.4 0Z"
              clip-rule="evenodd"
            />
          </svg>
          {item}
        </li>
      ))
    }
  </ul>
</div>
