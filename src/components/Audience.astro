---
import { site } from "../config/site";
import Section from "./ui/Section.astro";
import SectionHeading from "./ui/SectionHeading.astro";

const { audience } = site;
---

<Section id="para-quien">
  <SectionHeading title={audience.title} />

  <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
    <div class="rounded-3xl bg-sage-50 p-7 ring-1 ring-sage-200 sm:p-8">
      <h3 class="mb-5 font-display text-xl font-bold text-sage-900">Es para ti si…</h3>
      <ul class="space-y-4">
        {
          audience.for.map((item) => (
            <li class="flex gap-3">
              <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-sage-500" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.79 6.8-6.8a1 1 0 0 1 1.4 0Z"
                  clip-rule="evenodd"
                />
              </svg>
              <span class="leading-relaxed">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rounded-3xl bg-cream-100 p-7 ring-1 ring-cream-200 sm:p-8">
      <h3 class="mb-5 font-display text-xl font-bold text-ink">No es para ti si…</h3>
      <ul class="space-y-4">
        {
          audience.notFor.map((item) => (
            <li class="flex gap-3">
              <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-clay-500" aria-hidden="true">
                <path d="M5.3 5.3a1 1 0 0 1 1.4 0L10 8.6l3.3-3.3a1 1 0 1 1 1.4 1.4L11.4 10l3.3 3.3a1 1 0 0 1-1.4 1.4L10 11.4l-3.3 3.3a1 1 0 0 1-1.4-1.4L8.6 10 5.3 6.7a1 1 0 0 1 0-1.4Z" />
              </svg>
              <span class="leading-relaxed text-ink-soft">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
