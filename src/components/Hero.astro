---
import { site } from "../config/site";
import { formatPrice } from "../lib/format";
import CtaButton from "./ui/CtaButton.astro";
import SoapIllustration from "./SoapIllustration.astro";

const { hero } = site;
---

<section id="hero" class="relative overflow-hidden bg-cream-50">
  <div
    class="mx-auto grid max-w-6xl items-center gap-10 px-5 pb-14 pt-10 sm:px-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14 lg:pb-24 lg:pt-20"
  >
    <div>
      <p
        class="mb-5 inline-flex rounded-full bg-sage-100 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-sage-700 sm:text-sm"
      >
        {hero.eyebrow}
      </p>
      <h1 class="font-display text-4xl font-bold leading-[1.1] text-balance text-sage-900 sm:text-5xl lg:text-6xl">
        {hero.title}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft sm:text-xl">{hero.subtitle}</p>

      <ul class="mt-7 space-y-3">
        {
          hero.bullets.map((bullet) => (
            <li class="flex items-start gap-3 font-medium">
              <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-6 w-6 shrink-0 text-sage-500" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.86-9.64a.75.75 0 0 0-1.22-.88l-3.3 4.6-1.8-1.8a.75.75 0 1 0-1.06 1.06l2.4 2.4a.75.75 0 0 0 1.14-.1l3.84-5.28Z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>{bullet}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
        <CtaButton />
        <a
          href="#contenido"
          class="px-2 py-3 font-semibold text-sage-700 underline decoration-sage-300 underline-offset-4 transition hover:decoration-sage-700"
        >
          {site.cta.secondary}
        </a>
      </div>
      <p class="mt-4 text-sm text-ink-soft">
        {formatPrice(site.price.amount, site.price.currency)} · {site.price.note}
      </p>
    </div>

    <SoapIllustration class="mx-auto w-full max-w-sm sm:max-w-md lg:max-w-none" />
  </div>
</section>
