---
import { site } from "../config/site";
import CtaButton from "./ui/CtaButton.astro";

const nav = [
  { label: "Contenido", href: "#contenido" },
  { label: "Para quién", href: "#para-quien" },
  { label: "Preguntas", href: "#faq" },
];
---

<header class="sticky top-0 z-30 border-b border-sage-100 bg-cream-50/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="#hero" class="flex items-center gap-2.5 font-display text-xl font-bold text-sage-900">
      <img src="/favicon.svg" alt="" width="32" height="32" class="h-8 w-8" />
      {site.brand}
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      {
        nav.map((item) => (
          <a href={item.href} class="text-sm font-medium text-ink-soft transition hover:text-sage-700">
            {item.label}
          </a>
        ))
      }
    </nav>

    <CtaButton size="md" label="Quiero el curso" class="hidden sm:inline-flex" />
  </div>
</header>
