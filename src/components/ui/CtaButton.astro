---
import { site } from "../../config/site";

interface Props {
  label?: string;
  size?: "md" | "lg";
  class?: string;
}

const { label = site.cta.label, size = "lg", class: className = "" } = Astro.props;

const sizes = {
  md: "px-5 py-2.5 text-sm",
  lg: "px-8 py-4 text-base sm:text-lg",
};
---

<a
  href={site.checkoutUrl}
  data-checkout
  rel="noopener"
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full bg-honey-400 font-bold text-ink shadow-lg shadow-honey-500/25 transition hover:-translate-y-0.5 hover:bg-honey-300 hover:shadow-xl active:translate-y-0",
    sizes[size],
    className,
  ]}
>
  {label}
  <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
    <path
      fill-rule="evenodd"
      d="M3 10a.75.75 0 0 1 .75-.75h10.69l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z"
      clip-rule="evenodd"></path>
  </svg>
</a>
