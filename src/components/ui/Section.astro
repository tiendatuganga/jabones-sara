---
interface Props {
  id?: string;
  tone?: "cream" | "sand" | "sage" | "dark";
  class?: string;
}

const { id, tone = "cream", class: className = "" } = Astro.props;

const tones = {
  cream: "bg-cream-50 text-ink",
  sand: "bg-cream-100 text-ink",
  sage: "bg-sage-50 text-ink",
  dark: "bg-sage-900 text-cream-50",
};
---

<section id={id} class:list={["py-16 sm:py-24", tones[tone], className]}>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <slot />
  </div>
</section>
