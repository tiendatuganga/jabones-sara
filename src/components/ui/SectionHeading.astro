---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
  dark?: boolean;
}

const { eyebrow, title, subtitle, align = "center", dark = false } = Astro.props;
---

<header class:list={["mb-10 max-w-3xl sm:mb-14", align === "center" ? "mx-auto text-center" : ""]}>
  {
    eyebrow && (
      <p
        class:list={[
          "mb-3 text-sm font-semibold uppercase tracking-widest",
          dark ? "text-honey-300" : "text-sage-700",
        ]}
      >
        {eyebrow}
      </p>
    )
  }
  <h2 class="font-display text-3xl font-bold leading-tight text-balance sm:text-4xl">{title}</h2>
  {subtitle && <p class:list={["mt-4 text-lg", dark ? "text-cream-200" : "text-ink-soft"]}>{subtitle}</p>}
</header>
